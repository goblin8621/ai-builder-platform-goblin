{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-builder-platform/contracts/portable-skill.schema.json",
  "title": "PortableSkill",
  "description": "Provider-neutral Export intermediate representation (10번 Skill Export / Portable Skill 설계). SkillSpec remains the internal source of truth; this is the only shape every Export Adapter consumes. It deliberately contains NO provider names, NO Registry model ids, NO internal skill/document ids (Package-local aliases `child:<slug>` / `doc:<slug>` are used instead), NO secrets and NO timestamps — so the same inputs always produce the same document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion", "name", "description", "objective", "instructions", "guardrails",
    "skillType", "inputContract", "outputContract", "workflow", "dependencies",
    "requiredCapabilities", "requiredTools", "knowledge", "examples",
    "runtimeRequirements", "runtimeLimits"
  ],
  "properties": {
    "formatVersion": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "instructions": { "type": "array", "items": { "type": "string" } },
    "guardrails": { "type": "array", "items": { "type": "string" } },
    "skillType": { "type": "string", "enum": ["prompt", "knowledge", "tool", "workflow", "composite"] },
    "inputContract": { "type": "object" },
    "outputContract": { "type": "object" },
    "workflow": { "type": "array", "items": { "$ref": "#/definitions/step" } },
    "outputMapping": { "type": "object" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": { "ref": { "type": "string", "pattern": "^child:.+" } }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "web-search", "image-generation", "code-execution", "data-analysis",
              "file-analysis", "knowledge-search", "mcp"
            ]
          }
        }
      }
    },
    "requiredTools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "protocol", "inputSchema", "outputSchema"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "protocol": { "type": "string", "enum": ["builtin", "mcp"] },
          "inputSchema": { "type": "object" },
          "outputSchema": { "type": "object" }
        }
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "documents"],
        "properties": {
          "scope": { "type": "string", "enum": ["workspace", "selected"] },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "fileName", "mimeType", "included"],
              "properties": {
                "ref": { "type": "string", "pattern": "^doc:.+" },
                "fileName": { "type": "string", "minLength": 1 },
                "mimeType": { "type": "string" },
                "included": { "type": "boolean" },
                "path": {
                  "description": "ASCII-safe archive path (never derived from the display name).",
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
                },
                "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input"],
        "properties": { "description": { "type": "string" }, "input": {} }
      }
    },
    "runtimeRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresLLM", "requiresTools", "requiresMcp", "requiresKnowledge",
        "requiresCodeExecution", "requiresApproval", "requiresNestedSkill"
      ],
      "properties": {
        "requiresLLM": { "type": "boolean" },
        "requiresTools": { "type": "boolean" },
        "requiresMcp": { "type": "boolean" },
        "requiresKnowledge": { "type": "boolean" },
        "requiresCodeExecution": { "type": "boolean" },
        "requiresApproval": { "type": "boolean" },
        "requiresNestedSkill": { "type": "boolean" }
      }
    },
    "runtimeLimits": {
      "description": "Declared limits of the source Skill. NOT guaranteed to be enforceable on every Target — Compatibility Analyzer warns when a Target cannot enforce one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSec": { "type": "number" },
        "retryCount": { "type": "integer" },
        "maxToolCalls": { "type": "integer" },
        "maxNestedSkillDepth": { "type": "integer" }
      }
    },
    "source": {
      "description": "Optional provenance (internal ids). Present ONLY when the Export was requested with includeSourceSpec.",
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "skillVersion"],
      "properties": { "skillId": { "type": "string" }, "skillVersion": { "type": "integer" } }
    },
    "sourceSpec": {
      "description": "Optional original SkillSpec. Present ONLY when the Export was requested with includeSourceSpec.",
      "type": "object"
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["llm", "tool", "knowledge", "skill", "transform", "condition"] },
        "ref": { "type": "string" },
        "input": { "type": "object" },
        "outputKey": { "type": "string" },
        "condition": { "type": "string" },
        "requiresApproval": { "type": "boolean" },
        "onError": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "type": "string", "enum": ["fail", "retry", "skip", "fallback"] },
            "retryCount": { "type": "integer" },
            "fallbackStepId": { "type": "string" }
          }
        }
      }
    }
  }
}
